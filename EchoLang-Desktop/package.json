{
  "name": "echolang-desktop",
  "productName": "EchoLang",
  "version": "0.5.0",
  "private": true,
  "author": "Mu-scorpio",
  "description": "EchoLang translation desk for Windows",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:nsis": "tauri build --bundles nsis",
    "build:dir": "tauri build --no-bundle",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "prepare:installer": "node scripts/create-installer-assets.mjs",
    "prepare:desktop": "npm run prepare:runtime && npm run prepare:installer",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
